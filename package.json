{
  "name": "scriptpdf-server",
  "version": "2.0.0",
  "description": "Server stabile per gestione PDF con auto-start/stop",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon unified-server.js",
    "electron": "electron electron/main.js",
    "diagnostic": "node scripts/diagnostic-check.js",
    "test:system": "node test-system.js",
    "test:bordero": "node test/bordero-finish.test.js",
    "test:course-program": "node --test test/choreo-program.test.js",
    "test:course-week": "node --test test/bordero-course-week.test.js",
    "test:course-files": "node --test test/choreo-program-files.test.js",
    "test:admin": "node --test test/machine-ui-preferences.test.js",
    "test:monitor-layout": "node --test test/primary-monitor-layout.test.js",
    "test:navigation": "node test/navigation-window-routing.test.js",
    "build:brani": "node Eventi/sync-brani.js",
    "sync:public": "node scripts/sync-public.js",
    "build:public-display": "node scripts/build-public-display.js",
    "deploy:firebase": "firebase deploy --only hosting",
    "deploy:database": "firebase deploy --only database",
    "eventi": "npm run build:brani && node unified-server.js",
    "eventi:standalone": "npm run build:brani && node Eventi/server-eventi.js",
    "eventi:legacy": "npm run build:brani && node Eventi/server-eventi.js",
    "start:portable": "node scripts/start-portable.js"
  },
  "engines": {
    "node": "^20 || ^22 || >=24"
  },
  "keywords": [
    "pdf",
    "chrome",
    "kiosk",
    "excel",
    "choreography"
  ],
  "author": "Admin",
  "license": "MIT",
  "dependencies": {
    "csv-parse": "^7.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "firebase-admin": "^14.3.0",
    "firebase-tools": "^15.32.1",
    "jsdom": "^29.1.1",
    "qrcode": "^1.5.1",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^43.2.0",
    "eslint": "^10.13.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.9.10"
  },
  "overrides": {
    "qs": "^6.16.0",
    "uuid": "^11.1.1"
  }
}
