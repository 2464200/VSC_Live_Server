{
    "task.allowAutomaticTasks": "on",
    "task.autoDetect": "off",
    "task.problemMatchers.neverPrompt": true,
    "task.quickOpen.showAll": true,
    "liveServer.settings.port": 5503,
    "liveServer.settings.host": "localhost",
    "files.exclude": {
        "**/.startup-pids.json": true,
        "**/node_modules": true,
        "**/.git": true,
        "**/.vscode": false
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/.git": true,
        "**/logs": true
    },
    "chat.tools.terminal.autoApprove": {
        "/^node --test --test-name-pattern=\"mantiene l’ordine dei livelli in ogni ciclo\" test/scaletta-generator\\.test\\.js$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^node --test test/scaletta-generator\\.test\\.js$/": {
            "approve": true,
            "matchCommandLine": true
        }
    }
}
