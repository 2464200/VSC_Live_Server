{
    "task.allowAutomaticTasks": "on",
    "task.autoDetect": "off",
    "task.problemMatchers.neverPrompt": true,
    "task.quickOpen.showAll": true,
    "git.enabled": true,
    "git.autoRepositoryDetection": true,
    "liveServer.settings.port": 5503,
    "liveServer.settings.host": "localhost",
    "files.exclude": {
        "**/.startup-pids.json": true,
        "**/node_modules": true,
        "**/.git": true,
        "**/.vscode": false
    },
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/**": true,
        "**/.venv/**": true,
        "**/__pycache__/**": true,
        "**/*.pyc": true,
        "**/.firebase/**": true,
        "**/public-display/**": true,
        "**/logs/**": true,
        "**/_tmp_vbexport_*/**": true
    },
    "chat.tools.terminal.autoApprove": {
        "/^node --test --test-name-pattern=\"mantiene l’ordine dei livelli in ogni ciclo\" test/scaletta-generator\\.test\\.js$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^node --test test/scaletta-generator\\.test\\.js$/": {
            "approve": true,
            "matchCommandLine": true
        }
    },
    "files.encoding": "utf8",
    "files.autoSave": "off",
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": true,
    "editor.wordWrap": "on",
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": true,
    "editor.linkedEditing": true,
    "editor.minimap.enabled": false,
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false,
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },
    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },
    "[jsonc]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },
    "[markdown]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },
    "prettier.requireConfig": true,
    "eslint.validate": [
        "javascript"
    ],
    "eslint.format.enable": false,
    "html.validate.scripts": true,
    "html.validate.styles": true,
    "css.validate": true,
    "search.exclude": {
        "**/node_modules": true,
        "**/.git": true,
        "**/logs": true,
        "**/.firebase": true,
        "**/coverage": true,
        "**/.venv": true,
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/public-display": true,
        "**/_tmp_vbexport_*": true
    },
    "python.analysis.indexing": false,
    "python.analysis.exclude": [
        "**/.venv/**",
        "**/__pycache__/**",
        "**/*.pyc",
        "**/node_modules/**",
        "**/_tmp_vbexport_*/**",
        "**/public-display/**"
    ],
    "python.terminal.useEnvFile": true,
    "editor.tokenColorCustomizations": {
        "[*Light*]": {
            "textMateRules": [
                {
                    "scope": "entity.name.function.letter.nlp",
                    "settings": {
                        "foreground": "#dc1b1b"
                    }
                },
                {
                    "scope": "entity.name.function.nlp",
                    "settings": {
                        "foreground": "#000000"
                    }
                },
                {
                    "scope": [
                        "variable.parameter.nlp",
                        "keyword.control.kb"
                    ],
                    "settings": {
                        "foreground": "#696969",
                        "fontStyle": "bold"
                    }
                },
                {
                    "scope": "entity.other.attribute-name.nlp",
                    "settings": {
                        "foreground": "#e655f3"
                    }
                },
                {
                    "scope": "constant.language.nlp",
                    "settings": {
                        "foreground": "#0a7b83",
                        "fontStyle": "bold"
                    }
                },
                {
                    "scope": [
                        "keyword.operator.nlp",
                        "keyword.operator.word.nlp"
                    ],
                    "settings": {
                        "foreground": "#1f6feb"
                    }
                },
                {
                    "scope": [
                        "constant.numeric.tree",
                        "constant.numeric.kbb"
                    ],
                    "settings": {
                        "foreground": "#5596f0"
                    }
                },
                {
                    "scope": "keyword.other.fired.tree",
                    "settings": {
                        "foreground": "#dc1b1b",
                        "fontStyle": "bold"
                    }
                },
                {
                    "scope": "entity.name.type.tree",
                    "settings": {
                        "foreground": "#000000",
                        "fontStyle": "bold"
                    }
                },
                {
                    "scope": "string.unquoted.token.tree",
                    "settings": {
                        "foreground": "#4e8e3c",
                        "fontStyle": "bold"
                    }
                },
                {
                    "scope": "source.txxt",
                    "settings": {
                        "foreground": "#a5a5a5"
                    }
                },
                {
                    "scope": "keyword.other.txxt",
                    "settings": {
                        "foreground": "#6e60eb",
                        "fontStyle": "bold"
                    }
                },
                {
                    "scope": "comment.line.txxt",
                    "settings": {
                        "foreground": "#dd2c2c",
                        "fontStyle": "bold"
                    }
                },
                {
                    "scope": "variable.parameter.txxt",
                    "settings": {
                        "foreground": "#535353",
                        "fontStyle": "bold"
                    }
                },
                {
                    "scope": "entity.name.type.level0.kbb",
                    "settings": {
                        "foreground": "#5d00d6",
                        "fontStyle": "bold"
                    }
                },
                {
                    "scope": "entity.name.type.level1.kbb",
                    "settings": {
                        "foreground": "#7e7e7e",
                        "fontStyle": "bold"
                    }
                },
                {
                    "scope": "entity.name.type.level2.kbb",
                    "settings": {
                        "foreground": "#2eb657",
                        "fontStyle": "bold"
                    }
                },
                {
                    "scope": "entity.name.type.level3.kbb",
                    "settings": {
                        "foreground": "#e049d9",
                        "fontStyle": "bold"
                    }
                }
            ]
        },
        "[*Dark*]": {
            "textMateRules": [
                {
                    "scope": "entity.name.function.letter.nlp",
                    "settings": {
                        "foreground": "#dc1b1b"
                    }
                },
                {
                    "scope": "entity.name.function.nlp",
                    "settings": {
                        "foreground": "#8f8f8f",
                        "fontStyle": "bold"
                    }
                },
                {
                    "scope": [
                        "variable.parameter.nlp",
                        "keyword.control.kb"
                    ],
                    "settings": {
                        "foreground": "#f8fa87",
                        "fontStyle": "bold"
                    }
                },
                {
                    "scope": "entity.other.attribute-name.nlp",
                    "settings": {
                        "foreground": "#f293fb"
                    }
                },
                {
                    "scope": "constant.language.nlp",
                    "settings": {
                        "foreground": "#4ec9b0",
                        "fontStyle": "bold"
                    }
                },
                {
                    "scope": [
                        "keyword.operator.nlp",
                        "keyword.operator.word.nlp"
                    ],
                    "settings": {
                        "foreground": "#8ab4f8"
                    }
                },
                {
                    "scope": [
                        "constant.numeric.tree",
                        "constant.numeric.kbb"
                    ],
                    "settings": {
                        "foreground": "#93bffb"
                    }
                },
                {
                    "scope": "keyword.other.fired.tree",
                    "settings": {
                        "foreground": "#dc1b1b",
                        "fontStyle": "bold"
                    }
                },
                {
                    "scope": "entity.name.type.tree",
                    "settings": {
                        "foreground": "#f8fa87",
                        "fontStyle": "bold"
                    }
                },
                {
                    "scope": "string.unquoted.token.tree",
                    "settings": {
                        "foreground": "#4e8e3c",
                        "fontStyle": "bold"
                    }
                },
                {
                    "scope": "source.txxt",
                    "settings": {
                        "foreground": "#7e7e7e"
                    }
                },
                {
                    "scope": "variable.parameter.txxt",
                    "settings": {
                        "foreground": "#f8fa87"
                    }
                },
                {
                    "scope": "entity.name.type.level0.kbb",
                    "settings": {
                        "foreground": "#896eff",
                        "fontStyle": "bold"
                    }
                },
                {
                    "scope": "entity.name.type.level1.kbb",
                    "settings": {
                        "foreground": "#e3ee50",
                        "fontStyle": "bold"
                    }
                },
                {
                    "scope": "entity.name.type.level2.kbb",
                    "settings": {
                        "foreground": "#2eb657",
                        "fontStyle": "bold"
                    }
                },
                {
                    "scope": "entity.name.type.level3.kbb",
                    "settings": {
                        "foreground": "#e049d9",
                        "fontStyle": "bold"
                    }
                }
            ]
        }
    },
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "git.ignoreLimitWarning": true,
    "python-envs.defaultEnvManager": "ms-python.python:system"
}
