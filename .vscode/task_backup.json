{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "GitHub - Backup develop",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "$ErrorActionPreference = 'Stop'; " +
                "Write-Host ''; " +
                "Write-Host '=== BACKUP DEL BRANCH DEVELOP ===' -ForegroundColor Cyan; " +
                "Write-Host ''; " +
                "git fetch origin develop; " +
                "if ($LASTEXITCODE -ne 0) { throw 'Errore durante git fetch.' }; " +
                "$date = Get-Date -Format 'yyyy-MM-dd'; " +
                "$backup = \"develop-backup-$date\"; " +
                "$exists = git ls-remote --heads origin $backup; " +
                "if ($exists) { " +
                "    $time = Get-Date -Format 'HHmm'; " +
                "    $backup = \"develop-backup-$date-$time\"; " +
                "    Write-Host \"Backup della giornata gia esistente. Nuovo nome: $backup\" -ForegroundColor Yellow; " +
                "}; " +
                "Write-Host \"Creo $backup partendo da origin/develop...\" -ForegroundColor Cyan; " +
                "git push origin \"origin/develop:refs/heads/$backup\"; " +
                "if ($LASTEXITCODE -ne 0) { throw 'Errore durante la creazione del backup su GitHub.' }; " +
                "Write-Host ''; " +
                "Write-Host \"BACKUP CREATO: $backup\" -ForegroundColor Green; " +
                "Write-Host ''; "
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}